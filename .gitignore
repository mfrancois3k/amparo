# Secrets — never commit these
.env
.env.local
.env.*.local
*.pem
*.key

# Dependencies
node_modules/

# Build artifacts not meant to be tracked (app-src builds INTO app/, which IS tracked)
app-src/dist/
app-src/node_modules/

# Scratch: firecrawl research dumps and audio test artifacts — never shipped
.firecrawl/
test1.wav

# Generated post cards — rebuilt from tools/render-card.mjs on every run
content/cards/

# scrollcraft verification output: ~370MB of PNGs per harness run, per profile.
# The contact sheets and logs for the shipping run are committed explicitly;
# the raw frame folders are reproducible with shoot.mjs and are not history.
scrollcraft/builds/*/lab*/
!scrollcraft/builds/*/lab7/
scrollcraft/builds/*/lab7/*/
!scrollcraft/builds/*/lab7/*/sheet.png
scrollcraft/builds/*/node_modules/
# motion masters (raw mp4s, check frames) are reproducible from the stills with
# ffmpeg; the encoded finals ship under new/assets/motion
scrollcraft/builds/*/motion/
