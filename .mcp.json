{
  "mcpServers": {
    "muapi": {
      "command": "node",
      "args": [
        "D:/npm-global/node_modules/muapi-cli/bin/muapi",
        "mcp",
        "serve"
      ],
      "env": {
        "MUAPI_API_KEY": "${MUAPI_API_KEY}"
      }
    },
    "google-alerts": {
      "command": "C:/Python311/Scripts/uvx.exe",
      "args": [
        "google-alerts-mcp"
      ],
      "env": {}
    }
  }
}
